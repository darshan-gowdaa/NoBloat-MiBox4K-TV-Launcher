<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Ultra-thin 1.2dp Specular Rim, Pristine Liquid Glass Refraction -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="46dp" />
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:centerColor="#25FFFFFF"
                android:endColor="#12FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- Activated (Child focused inside capsule): Clean Subtle 1dp Frosted Rim -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="46dp" />
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#1EFFFFFF"
                android:endColor="#0EFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#50FFFFFF" />
        </shape>
    </item>

    <!-- Default Unfocused: Apple VisionOS Liquid Glass with Top Specular Crest & Optical Acrylic Rim -->
    <item>
        <layer-list>
            <!-- Caustic Base Shadow for Optical Glass Thickness -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="46dp" />
                    <solid android:color="#12000000" />
                </shape>
            </item>
            <!-- Specular Frosted Refraction Plate -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="46dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:centerColor="#1EFFFFFF"
                        android:endColor="#0CFFFFFF"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#50FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
