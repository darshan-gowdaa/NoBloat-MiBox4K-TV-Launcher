<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Base Acrylic Tint with Optical Depth Gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#EA1B222F"
                android:centerColor="#E4131822"
                android:endColor="#EE0C0F16"
                android:type="linear" />
        </shape>
    </item>
    <!-- Frosted Top Specular Crest Sheen (Apple Refraction Highlight) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Liquid Glass Optical Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1.2dp"
                android:color="#58FFFFFF" />
        </shape>
    </item>
</layer-list>
