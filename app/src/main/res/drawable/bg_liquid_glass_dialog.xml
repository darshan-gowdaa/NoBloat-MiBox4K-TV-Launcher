<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Apple Frosted Glass Base Acrylic Plate -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#E61A1E29"
                android:centerColor="#DF121620"
                android:endColor="#E80D1017"
                android:type="linear" />
        </shape>
    </item>
    <!-- Frosted Glass Soft Sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#28FFFFFF"
                android:centerColor="#0CFFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Crisp Frosted Glass Border Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1.2dp"
                android:color="#45FFFFFF" />
        </shape>
    </item>
</layer-list>
