<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- frosted glass dark plate -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#EE181818"
                android:centerColor="#E6131313"
                android:endColor="#EE0E0E0E"
                android:type="linear" />
        </shape>
    </item>
    <!-- white top sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#35FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- white glass border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1.2dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
