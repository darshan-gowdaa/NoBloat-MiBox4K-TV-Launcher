<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/sys_primary_container" />
            <stroke android:width="1.5dp" android:color="@color/sys_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/sys_surface_container_high" />
            <stroke android:width="1dp" android:color="@color/sys_outline" />
        </shape>
    </item>
</selector>
