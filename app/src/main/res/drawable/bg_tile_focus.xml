<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/m3_surface_container_high" />
            <stroke android:width="1.8dp" android:color="@color/m3_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/m3_surface_container" />
            <stroke android:width="1dp" android:color="@color/m3_outline_variant" />
        </shape>
    </item>
</selector>
