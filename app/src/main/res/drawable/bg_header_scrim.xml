<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid Pure Black Header Tint (Completely occludes all passing cards behind pinned header) -->
    <item android:bottom="42dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>

    <!-- Soft Ambient Drop Shadow Beneath Header Plate -->
    <item android:top="184dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF000000"
                android:centerColor="#99000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
